# Copy this file to .env for local runs. Never commit .env.
# In GitHub Actions these values are stored as repository secrets.

# X API (OAuth 2.0 with PKCE) — see docs once E10 is done
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=

# LLM provider for the AI editor
LLM_PROVIDER=
LLM_API_KEY=

# Password used to encrypt the published edition
EDITION_PASSWORD=
